# Otto's environment: copy to .env and fill in. Every key shared/config.py reads is listed.
# The uncommented keys are the ones a local setup needs. The commented ones have working
# defaults (shown in brackets); uncomment one only to change it, since an empty value
# overrides the default.

# --- Accounts ---------------------------------------------------------------------------
# Signs access tokens and GitHub OAuth state; at least 32 characters. The gateway won't start
# without it: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# How long an access token (the Bearer JWT) lasts, in minutes [15]
# ACCESS_TOKEN_MINUTES=
# How long an unused refresh token (the otto_refresh cookie) lasts, in days [30]
# REFRESH_TOKEN_DAYS=
# How long a just-rotated refresh token may come back as a retry instead of counting as theft [20]
# REFRESH_REUSE_GRACE_SECONDS=
# The web app's URL: GitHub callbacks and password-reset links go here; https:// makes cookies Secure [http://localhost:5173]
# FRONTEND_URL=
# Origins allowed to call the API with credentials and open the WebSocket, comma-separated [http://localhost:5173,http://localhost:3000]
# CORS_ORIGINS=
# A new user's daily token limit (UTC days) [300000]
# DAILY_TOKEN_LIMIT=

# --- LLM providers ----------------------------------------------------------------------
# OpenRouter keys. More keys rotate: OPENROUTER_API_KEY2, OPENROUTER_API_KEY3, ...
OPENROUTER_API_KEY=
# OpenAI key, for the models named in OTTO_OPENAI_MODELS
OPENAI_API_KEY=
# OpenAI models to offer, comma-separated, e.g. gpt-4.1-mini [none]
# OTTO_OPENAI_MODELS=
# A "custom" OpenAI-compatible provider: its base URL, key and model name [none]
# OTTO_BASE_URL=
# OTTO_API_KEY=
# The older name for OTTO_API_KEY, still read when OTTO_API_KEY is unset
# API_KEY=
# OTTO_MODEL=
# A JSON list of {id, provider, model, label, description} replacing the model catalog [built from the keys above]
# OTTO_MODELS=
# The catalog id new chats use [the first model whose provider has a key]
# OTTO_DEFAULT_MODEL=
# JSON {"<model id>": {"input_per_1m": USD, "output_per_1m": USD}} for the usage page [{} = free]
# MODEL_PRICES=
# A model call's total waiting on rate-limited keys, in seconds [120]
# MODEL_WAIT_BUDGET_SECONDS=
# Seconds per model request before it counts as a failed try [120]
# OTTO_LLM_TIMEOUT=

# --- GitHub App ---------------------------------------------------------------------------
# The App's ID, and the path to its private key (.pem; keep it outside the repo or in otto-secrets/)
GITHUB_APP_ID=
GITHUB_APP_KEY_PATH=
# The App's user OAuth ("Client ID" and a generated client secret): GitHub sign-in and installs
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's name in github.com/apps/<slug>
GITHUB_APP_SLUG=
# Only the fallback installation for `python -m orchestrator.cli create` [none]
# GITHUB_INSTALLATION_ID=

# --- Infrastructure -----------------------------------------------------------------------
# Postgres [postgresql+psycopg://otto:otto@localhost:5432/otto, the otto-pg container from scripts/dev_up.sh]
# DATABASE_URL=
# RabbitMQ, as the gateway and the brain worker reach it [amqp://guest:guest@localhost/]
# BUS_URL=
# RabbitMQ, as a sandbox pod reaches it inside the cluster [amqp://guest:guest@rabbitmq:5672/]
# SANDBOX_BUS_URL=
# The sandbox (runner) image [taufik041/otto-sandbox:dev]
# SANDBOX_IMAGE=
# The namespace sandbox Jobs run in [default]
# K8S_NAMESPACE=
# A sandbox's maximum age in seconds; it must stay under the 1h GitHub token [3000]
# SANDBOX_MAX_AGE_SECONDS=
# A sandbox exits after this many minutes without actions [30]
# SANDBOX_IDLE_MINUTES=
# Agent chats one user may have at work at once [3]
# MAX_ACTIVE_SESSIONS=
# Agent chats everyone together may have at work at once [3]
# MAX_ACTIVE_SANDBOXES=
# Jobs one brain worker runs at once [3]
# WORKER_CONCURRENCY=

# --- Set inside the sandbox by the orchestrator: don't set these here --------------------
# The sandbox's session id [s1]
# SESSION_ID=
# The repository the sandbox clones [none]
# REPO_URL=
# The short-lived GitHub installation token for pushing [none]
# GITHUB_TOKEN=
# The cloned repository's path [/workspace]
# OTTO_WORKSPACE=

# Otto in production (docker-compose.prod.yml): copy to .env next to it and fill in.
# Every variable is listed, none has a value. The uncommented ones are required. The commented
# ones have working defaults (in brackets); uncomment one only to set it, since an empty value
# overrides the default. docs/deploy.md explains each part. Set by the compose file, not here:
# OTTO_ENV (production), DATABASE_URL, BUS_URL, OTTO_SANDBOX_KUBECONFIG, GITHUB_APP_KEY_PATH.

# --- The stack ------------------------------------------------------------------------------
# Postgres's and RabbitMQ's passwords: long and URL-safe (they go into URLs), e.g. openssl rand -hex 24
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# The sandbox runners' own RabbitMQ user (otto-runner, only the sessions' queues; runner_user.sh
# makes it). The sandbox node's setup.sh puts it in the runners' Secret as RUNNER_AMQP_PASSWORD
RABBITMQ_RUNNER_PASSWORD=
# The Cloudflare Tunnel's token (Zero Trust > Networks > Tunnels); its public hostname → http://gateway:8000
CLOUDFLARE_TUNNEL_TOKEN=
# The backend image [ghcr.io/taufik041/otto-backend:main]; pin a commit's tag to roll back
# OTTO_IMAGE=
# The cloudflared image's tag [2026.10.0]
# CLOUDFLARED_VERSION=
# The gateway's port on the server's loopback, for checks and ssh tunnels [8000]
# GATEWAY_PORT=
# Where RabbitMQ listens on the server, for the sandbox node's runners: the Tailscale address
# (bootstrap.sh sets it), never a public one [127.0.0.1]
# RABBITMQ_BIND=

# --- Backups (scripts/backup_db.sh, nightly) -------------------------------------------------
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Where in the bucket [otto/db]
# BACKUP_S3_PREFIX=
# Days of dumps to keep [14]
# BACKUP_KEEP_DAYS=
# When, as a cron line in UTC [15 3 * * *]
# BACKUP_CRON=
# An S3-compatible store instead of AWS (R2, MinIO) [none]
# AWS_ENDPOINT_URL=

# --- Deployment -----------------------------------------------------------------------------
# The app's URL (https://): GitHub sign-in ends here, reset links start here
FRONTEND_URL=
# Origins that may read GET /health: the landing page [none]
OTTO_LANDING_ORIGINS=
# Origins allowed to call the API with credentials and open the WebSocket [FRONTEND_URL]
# CORS_ORIGINS=
# Trust CF-Connecting-IP for rate limits: 1 behind the tunnel [0]
OTTO_TRUST_PROXY=
# Serve /docs [0 in production]
# OTTO_DOCS=
# The version GET /health reports, e.g. the image's commit [the package version]
# OTTO_VERSION=

# --- Email (Resend: password resets, and "bring it back up" requests) ------------------------
# The gateway's "Sending access" key for taufi.dev (Resend key "otto-gateway"). Without it,
# production sends no email: "Forgot password?" is hidden and the app's ask button says so
RESEND_API_KEY=
# Where "bring it back up" requests go (your inbox); the asker is the reply-to, never emailed
OTTO_NOTIFY_TO=
# The sender, on the verified domain [Otto <noreply@taufi.dev>]
# EMAIL_FROM=

# --- Accounts and signups -------------------------------------------------------------------
# Signs tokens; at least 32 characters: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# open, allowlist or closed [allowlist in production]
# OTTO_SIGNUP_MODE=
# GitHub logins and emails that may sign up in allowlist mode, comma-separated [none]
# OTTO_ALLOWED_GITHUB=
# OTTO_ALLOWED_EMAILS=
# false pauses every signup [true]
# OTTO_ACCEPTING=
# Access token minutes [15], refresh token days [30], refresh retry grace seconds [20]
# ACCESS_TOKEN_MINUTES=
# REFRESH_TOKEN_DAYS=
# REFRESH_REUSE_GRACE_SECONDS=
# A new user's daily token limit [300000]
# DAILY_TOKEN_LIMIT=

# --- GitHub App -----------------------------------------------------------------------------
# Its key goes in secrets/github-app.pem
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# The gateway's https://.../auth/github/callback, one of the App's callback URLs
OTTO_GITHUB_CALLBACK_URL=
# Only the fallback for `python -m orchestrator.cli create` [none]
# GITHUB_INSTALLATION_ID=

# --- LLM providers --------------------------------------------------------------------------
# At least one provider's key. More OpenRouter keys rotate: OPENROUTER_API_KEY2, ...
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OpenAI models to offer, comma-separated [none]
# OTTO_OPENAI_MODELS=
# A "custom" OpenAI-compatible provider [none]; API_KEY is OTTO_API_KEY's older name
# OTTO_BASE_URL=
# OTTO_API_KEY=
# API_KEY=
# OTTO_MODEL=
# The model catalog as JSON, and the default model [built from the keys]
# OTTO_MODELS=
# OTTO_DEFAULT_MODEL=
# Prices for the usage page, JSON [free]
# MODEL_PRICES=
# Seconds: waiting on rate-limited keys [120], one model request [120]
# MODEL_WAIT_BUDGET_SECONDS=
# OTTO_LLM_TIMEOUT=

# --- The sandbox cluster (its kubeconfig goes in secrets/sandbox.kubeconfig) -----------------
# The namespace sandbox Jobs run in; K8S_NAMESPACE is the older name [default]
OTTO_SANDBOX_NAMESPACE=
# K8S_NAMESPACE=
# The Secret in that namespace holding the runners' RabbitMQ URL, and its key [none; url]
OTTO_RUNNER_AMQP_SECRET=
# OTTO_RUNNER_AMQP_SECRET_KEY=
# The runners' RabbitMQ URL when no Secret is named; SANDBOX_BUS_URL is the older name
# OTTO_RUNNER_AMQP_URL=
# SANDBOX_BUS_URL=
# The sandbox image, built by CI on main [ghcr.io/taufik041/otto-sandbox:main]
# SANDBOX_IMAGE=
# Seconds between reachability checks [20 here]
# OTTO_WORKERS_CHECK_SECONDS=
# A sandbox's CPU, memory and disk [200m/1, 300Mi/1Gi, 1Gi/4Gi], and its user id [1000]
# OTTO_SANDBOX_CPU_REQUEST=
# OTTO_SANDBOX_CPU_LIMIT=
# OTTO_SANDBOX_MEMORY_REQUEST=
# OTTO_SANDBOX_MEMORY_LIMIT=
# OTTO_SANDBOX_STORAGE_REQUEST=
# OTTO_SANDBOX_STORAGE_LIMIT=
# OTTO_SANDBOX_UID=
# A sandbox's maximum age in seconds [3000], idle minutes before it exits [30]
# SANDBOX_MAX_AGE_SECONDS=
# SANDBOX_IDLE_MINUTES=
# Agent chats at work: per user [3], everyone's [3]; jobs per worker [3]. Everyone's must not
# be more than the sandbox node's SANDBOX_SLOTS (1 on a 2 GB node)
# MAX_ACTIVE_SESSIONS=
# MAX_ACTIVE_SANDBOXES=
# WORKER_CONCURRENCY=
